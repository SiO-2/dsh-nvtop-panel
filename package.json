{
  "name": "dsh-nvtop-panel",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "description": "nvtop-style live GPU dashboard panel for the DeepSeek Harness (DSH) Web UI: per-GPU utilization/memory/temperature/power cards plus a full nvtop-like process table (PID, USER, DEV, TYPE, GPU, GPU MEM, CPU, HOST MEM, Command).",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "nvtop",
    "nvidia-smi",
    "gpu",
    "monitoring",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
